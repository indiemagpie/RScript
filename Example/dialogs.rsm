dialogAnswer("DialogAnswer24", {text: "С превеликим удовольствием!", answerCommand: "restart"});

dialogAnswer("DialogAnswer25", {text: "Все это весьма занимательно, но я тут причем?", next: "DialogMsg20"});

dialogAnswer("DialogAnswer26", {text: "Я не понимаю, о чем вы говорите.", code: function() {
    gov_talk = 1;
    if (block_sys_date){block_sys_date = 0;
    NoComeKlingToStar(ShipStar(Player()), 0);}
    DChange('DialogMsg21');
    exit;
}});

dialogAnswer("DialogAnswer27", {text: "Я согласен. Мое задание - ликвидировать <0>.", code: function() {
    gov_talk = 1;
    if (block_sys_date){block_sys_date = 0;
    NoComeKlingToStar(ShipStar(Player()), 0);}
    DChange('DialogMsg22');
    exit;
}});

dialogAnswer("DialogAnswer28", {text: "Давно бы так!", answerCommand: "planet"});

dialogAnswer("DialogAnswer29", {text: "Так точно.", answerCommand: "planet"});

dialogAnswer("DialogAnswer30", {text: "Ясно.", answerCommand: "restart"});

dialogAnswer("DialogAnswer31", {text: "Спасибо!", next: "DialogMsg23"});

dialogAnswer("DialogAnswer32", {text: "Ну, вымогатели! Ладно, вот ваши деньги.", code: function() {
    while (GetShipPirateRank(Player())<2){RaisePirateRank(Player());}
    ShipMoney(Player(),ShipMoney(Player())-money_for_rank);
    Sound('Sound.Buy');
    ShipOut(Player());
    DChange('DialogMsg27');
    exit;
}});

dialogAnswer("DialogAnswer33", {text: "Не буду я вам столько платить! На такие деньги я могу целый год жить!", answerCommand: "restart"});

dialogAnswer("DialogAnswer34", {text: "Угу, спасибо.", answerCommand: "restart"});

