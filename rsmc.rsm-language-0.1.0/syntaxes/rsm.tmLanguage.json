{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Ranger Script Module",
  "scopeName": "source.rsm",
  "fileTypes": ["rsm"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#module-keywords" },
    { "include": "#declaration-calls" },
    { "include": "#control-keywords" },
    { "include": "#storage-types" },
    { "include": "#builtin-functions" },
    { "include": "#builtin-constants" },
    { "include": "#object-keys" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.rsm",
          "match": "//.*$"
        },
        {
          "name": "comment.block.rsm",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.rsm",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "name": "constant.character.escape.rsm", "match": "\\\\(.|\\r?\\n)" }
          ]
        },
        {
          "name": "string.quoted.single.rsm",
          "begin": "'",
          "end": "'",
          "patterns": [
            { "name": "constant.character.escape.rsm", "match": "\\\\(.|\\r?\\n)" }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.rsm",
          "match": "\\b[0-9]+\\.[0-9]+\\b"
        },
        {
          "name": "constant.numeric.integer.rsm",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "module-keywords": {
      "patterns": [
        {
          "name": "keyword.control.module.rsm",
          "match": "\\b(import|export|from)\\b"
        },
        {
          "name": "storage.type.function.rsm",
          "match": "\\bfunction\\b"
        }
      ]
    },
    "declaration-calls": {
      "comment": "rsmc top-level declaration functions - globalVar/localVar/star/planet/ship/state/dialog/etc.",
      "patterns": [
        {
          "name": "support.function.declaration.rsm",
          "match": "\\b(globalVar|localVar|constellation|starLink|star|planet|ship|groupLink|group|place|item|state|dialogMsg|dialogAnswer|dialog|ether)\\b(?=\\s*\\()"
        }
      ]
    },
    "control-keywords": {
      "patterns": [
        {
          "name": "keyword.control.rsm",
          "match": "\\b(if|else|for|while|break|continue|exit|throw|result)\\b"
        }
      ]
    },
    "storage-types": {
      "comment": "Typed local declarations inside code bodies.",
      "patterns": [
        {
          "name": "storage.type.rsm",
          "match": "\\b(int|dword|str|float|unknown|ref)\\b"
        }
      ]
    },
    "builtin-functions": {
      "comment": "\"Rangers Functions\"/\"Custom Functions\" key lists.",
      "patterns": [
        {
          "name": "support.function.builtin.rsm",
          "match": "\\b(abs|ABShipModifiers|AddDialogBlock|AddDialogInject|AddDialogOverride|AddItemToPlanet|AddItemToShip|AddItemToShop|AddItemToStorage|AddJournalRecord|AddPlanetNews|AdjustRuinsGoodsPricesToStorage|AdvancedAdjustmentSet|AllShipOut|Angle|arctan|ArrangeItems|ArrayAdd|arraychange|ArrayClear|ArrayDelete|ArrayDim|ArrayFind|ArrayFindInSorted|ArrayRandomize|ArraySort|ArraySortPartial|ArtefactTypeBoosted|ArtefactTypeInUse|ArtTranclucatorToShip|AsteroidGraph|AsteroidMinerals|AsteroidRespawn|AutoBattle|Blazer|BlazerLanding|BlazerSelfDestruction|BlockExist|BonusCount|BonusCustomTag|BonusIsSpecial|BonusName|BonusNumInCfg|BonusPriority|BonusText|BonusValue|BuildCustomRuins|BuildListOfMMByPriority|BuildListOfNewShips|BuildListOfQuestPossibleLocations|BuildRuins|ButtonClick|BuyBigWarrior|BuyDomik|BuyDomikExtremal|BuyPirate|BuyRanger|BuyTranclucator|BuyTransport|BuyWarrior|CanSellItem|CapitalShipStats|Chameleon|ChanceToWin|ChangeGlobalRelationsPlanets|ChangeGlobalRelationsShips|ChangeState|CloseCustomForm|CoalitionDefeated|ConChangeRelationToRanger|ConName|ConNear|ConStar|ConStars|ContainerFuel|ControlledSystems|ConvertToABShip|CoordX|CoordY|copy|cos|count|CountBox|CountIn|CountReward|CountRewardByNom|CountTurn|CreateABShip|CreateActCodeEvent|CreateArt|CreateCustomArt|CreateCustomCountableItem|CreateCustomWeapon|CreateEquipment|CreateEquipmentWithSpecial|CreateGoods|CreateHull|CreateMM|CreateNodes|CreatePlanet|CreateQuestItem|CreateZond|CT|CurInfo|CurItem|CurrentForm|CurrentMods|CurTurn|CustomArtCostCalc|CustomArtData|CustomArtSizeCalc|CustomArtTextData|CustomEther|CustomInterfaceImage|CustomInterfacePos|CustomInterfacePosZ|CustomInterfaceSize|CustomInterfaceState|CustomInterfaceText|CustomLose|CustomMissileType|CustomWeaponType|CustomWeaponTypes|CustomWin|DAdd|DAddText|DAnswer|DChange|DealDamageToShip|DecayGoods|delete|DeleteEquipment|DeleteRewardByNom|DeleteTags|DeltaWin|Dialog|Dist|Dist2Star|DistCoords|DistToNearestEnemySystem|DomikKilledInCurSystem|DomikProgr