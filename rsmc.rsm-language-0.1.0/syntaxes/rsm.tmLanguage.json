kCost|substr|SwitchToMirrorImage|TalkByAI|Terron|TerronGrowLock|TerronLandingLock|TerronToStar|TerronWeaponLock|TextBox|Tips|TipsState|toansi|tounicode|TranclucatorData|TransferShip|trim|TrimNumbers|TruceBetweenShips|UICheckElement|UpdateFormShip|uppercase|UpsurgeGoods|UselessItemCreate|UselessItemData|UselessItemText|UseTranclucator|UtilityFunctionsLibInit|WeaponAmmunition|WeaponHit|WeaponMaxAmmunition|WeaponTarget)\\b(?=\\s*\\()"
        }
      ]
    },
    "builtin-constants": {
      "comment": "\"Rangers Constant\" key list.",
      "patterns": [
        {
          "name": "constant.language.rsm",
          "match": "\\b(bonAIValue|bonAmmo|bonAttacks|bonDef|bonDroid|bonExtraAkrinEff|bonExtraAkrinPenalty|bonFuel|bonHook|bonHookMaxSpeed|bonHookMinSpeed|bonHookRadius|bonHull|bonJump|bonMass|bonMissileSpeed|bonNull|bonRadar|bonResistAsteroid|bonScan|bonShots|bonShotSpeed|bonSkill1|bonSkill2|bonSkill3|bonSkill4|bonSkill5|bonSkill6|bonSlotArt|bonSlotDef|bonSlotDroid|bonSlotForsage|bonSlotHook|bonSlotRadar|bonSlotScaner|bonSlotWeapon|bonSpeed|bonStimCapacity|bonWEnergy|bonWMissile|bonWRadius|bonWSplinter|bonZonds|br|clr|clrEnd|color|CurShip|EndState|Fei|ForAccomplishment|ForCowardice|ForLiberationSystem|ForPerfidy|ForPlanetBattle|ForSecretMission|Gaal|GABStatus|GAnswerData|GQuestStatus|GRunFrom|GScriptName|GVideoStatus|Kling|Maloc|None|Peleng|People|pi|Pirate|PirateClan|progDematerial|progEnergotron|progIntercom|progKellerCall|progLogicalNegation|progSabCrack|ReBad|ReBest|ReGood|ReNormal|ReWar|t_Alcohol|t_Arms|t_ArtArtefactor|t_ArtBio|t_ArtBlackHole|t_ArtDecelerate|t_ArtDefToArms1|t_ArtDefToArms2|t_ArtDefToEnergy|t_Artefact|t_Artefact2|t_ArtefactAnalyzer|t_ArtefactAntigrav|t_ArtefactBomb|t_ArtefactDef|t_ArtefactDroid|t_ArtefactFuel|t_ArtefactHook|t_ArtefactHull|t_ArtefactMiniExpl|t_ArtefactNano|t_ArtefactPower|t_ArtefactRadar|t_ArtefactScaner|t_ArtefactSpeed|t_ArtefactTranclucator|t_ArtefactTransmitter|t_ArtEnergyDef|t_ArtEnergyPulse|t_ArtFastRacks|t_ArtForsage|t_ArtGiperJump|t_ArtMissileDef|t_ArtPDTurret|t_ArtSplinter|t_ArtWeaponToSpeed|t_BK|t_CargoHook|t_CB|t_Cistern|t_CustomWeapon|t_DefGenerator|t_Engine|t_Food|t_FuelTanks|t_Hull|t_Kling|t_Luxury|t_MC|t_Medicine|t_MicroModule|t_Minerals|t_Narcotics|t_OnABItemDrop|t_OnAnotherGoods|t_OnAnotherItem|t_OnAnotherItem2|t_OnChameleonConfusion|t_OnCheckingUsability|t_OnCheckingUsability2|t_OnCheckingUsabilityGoods|t_OnCustomTargetting|t_OnCustomTargettingCheck|t_OnDealingDamage|t_OnDealingFatalDamage|t_OnDeath|t_OnDroidRepair|t_OnDropItem|t_OnDropItemFixed|t_OnEnteringForm|t_OnEnteringOtherShip|t_OnGettingMissileHit|t_OnGettingWeaponHit|t_OnGovItemReward|t_OnItemDeEquip|t_OnItemDestroy|t_OnItemEquip|t_OnItemHit|t_OnItemPickUp|t_OnLeavingForm|t_OnLeavingOtherShip|t_OnMissileHittingObject|t_OnMissileShot|t_OnMissileShot2|t_OnMovingItemToStorage|t_OnNonStandartEqChange|t_OnPlayerBuyEq|t_OnPlayerChangeHull|t_OnPlayerSkillIncrease|t_OnPlayerTalkedWithShip|t_OnPlayerUseMM|t_OnReduceEqBattle|t_OnReduceEqForce|t_OnReduceEqForsage|t_OnReduceEqUse|t_OnReEnteringForm|t_OnReEnteringOtherShip|t_OnScan|t_OnScanPossibility|t_OnShipBuysGoods|t_OnShipSellsGoods|t_OnShipTalkedWithPlayer|t_OnShowingItemInfo|t_OnShowingShipInfo|t_OnShowingStarInfo|t_OnStartAB|t_OnStep|t_OnTakingDamage|t_OnTakingDamageEn|t_OnTakingDamageMi|t_OnTakingDamageSp|t_OnTrancPacking|t_OnWeaponShot|t_OnWeaponShot2|t_PB|t_Pirate|t_Protoplasm|t_Radar|t_Ranger|t_RC|t_RepairRobot|t_Satellite|t_SB|t_Scaner|t_Technics|t_Tranclucator|t_Transport|t_UB|t_UselessCountableItem|t_UselessItem|t_Warrior|t_WB|t_Weapon1|t_Weapon10|t_Weapon11|t_Weapon12|t_Weapon13|t_Weapon14|t_Weapon15|t_Weapon16|t_Weapon17|t_Weapon18|t_Weapon2|t_Weapon3|t_Weapon4|t_Weapon5|t_Weapon6|t_Weapon7|t_Weapon8|t_Weapon9|TalkAttack|TalkBreakPartner|TalkGoods|TalkMoney|TalkPartnerRiot|TalkPartnerTheEnd|TalkTruce|Trader|UselessItem|Warrior)\\b"
        }
      ]
    },
    "object-keys": {
      "comment": "Option-object keys in declaration calls.",
      "patterns": [
        {
          "name": "variable.parameter.rsm",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\b(?=\\s*:)"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.rsm",
          "match": "(==|!=|<=|>=|&&|\\|\\||[+\\-*/%=!<>&|^~])"
        },
        {
          "name": "punctuation.rsm",
          "match": "[(){}\\[\\];,.]"
        }
      ]
    }
  }
